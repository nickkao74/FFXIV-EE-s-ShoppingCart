{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ffxiv-ee-shopping-cart",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",

  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "build": {
    "command": "npm run typecheck"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ffxiv-ee-shopping-cart-db",
      "database_id": "7f4ca1dd-6cbb-4325-af48-602d3fd1fb02"
    }
  ],

  "vars": {
    "DISCORD_CLIENT_ID": "511750972859482122",
    "DISCORD_GUILD_ID": "972396880602472478",
    "DISCORD_ADMIN_ROLE_ID": "1022122898074378250",
    "DISCORD_ADMIN_USER_IDS": ["1508744006325112832","295122533492064258"]
  }
}